# ChainPulse API Keys — rename to .env and fill in your keys
# Get free keys from the links below

# Etherscan (ETH transactions, token holders)
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# BscScan (BNB Chain)
# https://bscscan.com/apis
BSCSCAN_API_KEY=

# Arbiscan (Arbitrum)
# https://arbiscan.io/apis
ARBISCAN_API_KEY=

# Moralis (multi-chain wallet data, NFTs)
# https://moralis.io
MORALIS_API_KEY=

# Covalent (multi-chain token holders, DeFi)
# https://www.covalenthq.com/
COVALENT_API_KEY=

# Alchemy (ETH/Polygon/Arb enhanced RPC)
# https://alchemy.com
ALCHEMY_API_KEY=

# Solana RPC (optional — defaults to public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Note: CoinGecko and DeFiLlama APIs are used without keys (free tier)
# For higher rate limits, add CoinGecko Pro key:
# COINGECKO_API_KEY=
